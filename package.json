{
  "name": "czu-study-dashboard",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "electron:compile": "vite build -c vite.electron.config.ts",
    "electron:dev": "npm run electron:compile && electron .",
    "electron:build": "npm run build && npm run electron:compile && electron-builder --mac --arm64",
    "electron:publish": "npm run build && npm run electron:compile && electron-builder --mac --arm64 --publish always"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  },
  "description": "ČZU Study Dashboard: Notion study hub (Dnes, Předměty, Timeline) as a web and macOS app",
  "main": "dist-electron/main.cjs",
  "build": {
    "appId": "cz.honza.czu-study-dashboard",
    "productName": "CZU Study Dashboard",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.education",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": "-"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Valentys289",
        "repo": "CZU-learner",
        "releaseType": "draft"
      }
    ]
  }
}
